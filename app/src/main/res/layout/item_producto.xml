<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="@android:color/white"> <!-- Fondo blanco para evitar sombreado -->

    <!-- CardView para la imagen redondeada del producto -->
    <androidx.cardview.widget.CardView
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:cardCornerRadius="150dp"
        android:layout_margin="10dp">

        <ImageView
            android:id="@+id/imgFotoProducto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher_round"/>
    </androidx.cardview.widget.CardView>

    <!-- TextView para el nombre del producto -->
    <TextView
        android:id="@+id/lblNombreProducto"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="80dp"
        android:text="Nombre del Producto"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- TextView para la marca del producto -->
    <TextView
        android:id="@+id/lblMarcaProducto"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="80dp"
        android:text="Marca: MarcaX"
        android:textColor="@android:color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- TextView para el código del producto -->
    <TextView
        android:id="@+id/lblCodigoProducto"
        android:layout_marginTop="50dp"
        android:layout_marginLeft="80dp"
        android:text="Código: PROD001"
        android:textColor="@android:color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- TextView para la descripción del producto -->
    <TextView
        android:id="@+id/lblDescripcionProducto"
        android:layout_marginTop="70dp"
        android:layout_marginLeft="80dp"
        android:text="Descripción: Laptop Gamer"
        android:textColor="@android:color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- TextView para la presentación del producto -->
    <TextView
        android:id="@+id/lblPresentacionProducto"
        android:layout_marginTop="90dp"
        android:layout_marginLeft="80dp"
        android:text="Presentación: 15 pulgadas"
        android:textColor="@android:color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- TextView para el precio del producto -->
    <TextView
        android:id="@+id/lblPrecioProducto"
        android:layout_marginTop="110dp"
        android:layout_marginLeft="80dp"
        android:text="Precio: $1200.50"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</RelativeLayout>